{
  "mcpServers": {
    "glyphpact": {
      "command": "uv",
      "args": [
        "tool",
        "run",
        "--quiet",
        "--no-progress",
        "--color",
        "never",
        "--no-config",
        "--isolated",
        "--from",
        "${CLAUDE_PLUGIN_ROOT}/dist/glyphpact-1.1.0-py3-none-any.whl",
        "--with-requirements",
        "${CLAUDE_PLUGIN_ROOT}/dist/mcp-requirements.txt",
        "glyphpact-mcp"
      ]
    }
  }
}
