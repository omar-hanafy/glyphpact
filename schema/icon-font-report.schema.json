{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/omar-hanafy/glyphpact/main/schema/icon-font-report.schema.json",
  "title": "GlyphPact deterministic build report",
  "oneOf": [
    { "$ref": "#/$defs/reportV2" },
    { "$ref": "#/$defs/reportV1" }
  ],
  "$defs": {
    "reportV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "generator",
        "generatorVersion",
        "status",
        "quality",
        "policy",
        "discoveredIconCount",
        "glyphCount",
        "losslessGlyphCount",
        "approximatedGlyphCount",
        "skippedIconCount",
        "issueCount",
        "issues",
        "retiredCodepointCount",
        "textFonts",
        "font",
        "layerFonts",
        "dart",
        "lockFile",
        "attributionFile",
        "glyphs",
        "skippedIcons"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "generator": { "const": "glyphpact" },
        "generatorVersion": { "type": "string", "minLength": 1 },
        "status": { "const": "success" },
        "quality": { "enum": ["lossless", "approximated", "partial"] },
        "policy": { "$ref": "#/$defs/policy" },
        "discoveredIconCount": { "type": "integer", "minimum": 1, "maximum": 65534 },
        "glyphCount": { "type": "integer", "minimum": 1, "maximum": 65534 },
        "losslessGlyphCount": { "type": "integer", "minimum": 0, "maximum": 65534 },
        "approximatedGlyphCount": { "type": "integer", "minimum": 0, "maximum": 65534 },
        "skippedIconCount": { "type": "integer", "minimum": 0, "maximum": 65534 },
        "issueCount": { "type": "integer", "minimum": 0 },
        "issues": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/lossyIssue" },
              { "$ref": "#/$defs/skippedIssue" }
            ]
          }
        },
        "retiredCodepointCount": { "type": "integer", "minimum": 0 },
        "textFonts": {
          "type": "array",
          "items": { "$ref": "#/$defs/textFont" },
          "maxItems": 64,
          "uniqueItems": true
        },
        "font": { "$ref": "#/$defs/font" },
        "layerFonts": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/layerFont" }
        },
        "dart": { "$ref": "#/$defs/dart" },
        "lockFile": { "type": "string", "minLength": 1 },
        "attributionFile": { "const": "ATTRIBUTION.md" },
        "glyphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65534,
          "items": { "$ref": "#/$defs/glyphV2" }
        },
        "skippedIcons": {
          "type": "array",
          "maxItems": 65534,
          "items": { "$ref": "#/$defs/skippedIcon" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "quality": { "const": "lossless" } },
            "required": ["quality"]
          },
          "then": {
            "properties": {
              "losslessGlyphCount": { "minimum": 1 },
              "approximatedGlyphCount": { "const": 0 },
              "skippedIconCount": { "const": 0 },
              "issueCount": { "const": 0 },
              "issues": { "maxItems": 0 },
              "glyphs": {
                "items": {
                  "properties": { "conversion": { "const": "lossless" } },
                  "required": ["conversion"]
                }
              },
              "skippedIcons": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "quality": { "const": "approximated" } },
            "required": ["quality"]
          },
          "then": {
            "properties": {
              "approximatedGlyphCount": { "minimum": 1 },
              "skippedIconCount": { "const": 0 },
              "issueCount": { "minimum": 1 },
              "issues": {
                "minItems": 1,
                "items": { "$ref": "#/$defs/lossyIssue" }
              },
              "glyphs": {
                "contains": {
                  "properties": { "conversion": { "const": "approximated" } },
                  "required": ["conversion"]
                }
              },
              "skippedIcons": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "quality": { "const": "partial" } },
            "required": ["quality"]
          },
          "then": {
            "properties": {
              "skippedIconCount": { "minimum": 1 },
              "issueCount": { "minimum": 1 },
              "issues": {
                "minItems": 1,
                "contains": { "$ref": "#/$defs/skippedIssue" }
              },
              "skippedIcons": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "properties": { "lossy": { "const": "error" } },
                "required": ["lossy"]
              }
            },
            "required": ["policy"]
          },
          "then": {
            "properties": {
              "issues": {
                "items": {
                  "anyOf": [
                    { "$ref": "#/$defs/scopedLayeredFallbackIssue" },
                    { "$ref": "#/$defs/skippedIssue" }
                  ]
                }
              },
              "glyphs": {
                "items": {
                  "if": {
                    "properties": { "conversion": { "const": "approximated" } },
                    "required": ["conversion"]
                  },
                  "then": {
                    "required": ["layeredRendering"],
                    "properties": {
                      "issues": {
                        "items": { "$ref": "#/$defs/scopedLayeredFallbackIssue" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "properties": { "unrepresentable": { "const": "error" } },
                "required": ["unrepresentable"]
              }
            },
            "required": ["policy"]
          },
          "then": {
            "properties": {
              "skippedIconCount": { "const": 0 },
              "issues": {
                "not": { "contains": { "$ref": "#/$defs/skippedIssue" } }
              },
              "skippedIcons": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "losslessGlyphCount": { "const": 0 } },
            "required": ["losslessGlyphCount"]
          },
          "then": {
            "properties": {
              "glyphs": {
                "not": {
                  "contains": {
                    "properties": { "conversion": { "const": "lossless" } },
                    "required": ["conversion"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "losslessGlyphCount": { "minimum": 1 } },
            "required": ["losslessGlyphCount"]
          },
          "then": {
            "properties": {
              "glyphs": {
                "contains": {
                  "properties": { "conversion": { "const": "lossless" } },
                  "required": ["conversion"]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "approximatedGlyphCount": { "const": 0 } },
            "required": ["approximatedGlyphCount"]
          },
          "then": {
            "properties": {
              "issues": {
                "not": { "contains": { "$ref": "#/$defs/lossyIssue" } }
              },
              "glyphs": {
                "items": {
                  "properties": { "conversion": { "const": "lossless" } },
                  "required": ["conversion"]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "approximatedGlyphCount": { "minimum": 1 } },
            "required": ["approximatedGlyphCount"]
          },
          "then": {
            "properties": {
              "issues": { "contains": { "$ref": "#/$defs/lossyIssue" } },
              "glyphs": {
                "contains": {
                  "properties": { "conversion": { "const": "approximated" } },
                  "required": ["conversion"]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "skippedIconCount": { "const": 0 } },
            "required": ["skippedIconCount"]
          },
          "then": {
            "properties": {
              "issues": {
                "not": { "contains": { "$ref": "#/$defs/skippedIssue" } }
              },
              "skippedIcons": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "skippedIconCount": { "minimum": 1 } },
            "required": ["skippedIconCount"]
          },
          "then": {
            "properties": {
              "issues": { "contains": { "$ref": "#/$defs/skippedIssue" } },
              "skippedIcons": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "issueCount": { "const": 0 } },
            "required": ["issueCount"]
          },
          "then": { "properties": { "issues": { "maxItems": 0 } } }
        },
        {
          "if": {
            "properties": { "issueCount": { "minimum": 1 } },
            "required": ["issueCount"]
          },
          "then": { "properties": { "issues": { "minItems": 1 } } }
        }
      ]
    },
    "reportV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "generator",
        "generatorVersion",
        "status",
        "glyphCount",
        "retiredCodepointCount",
        "font",
        "dart",
        "lockFile",
        "attributionFile",
        "glyphs"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "generator": { "const": "glyphpact" },
        "generatorVersion": { "type": "string", "minLength": 1 },
        "status": { "const": "success" },
        "glyphCount": { "type": "integer", "minimum": 1, "maximum": 65534 },
        "retiredCodepointCount": { "type": "integer", "minimum": 0 },
        "font": { "$ref": "#/$defs/font" },
        "dart": { "$ref": "#/$defs/dart" },
        "lockFile": { "type": "string", "minLength": 1 },
        "attributionFile": { "const": "ATTRIBUTION.md" },
        "glyphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65534,
          "items": { "$ref": "#/$defs/glyphV1" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lossy", "unrepresentable"],
      "properties": {
        "lossy": {
          "enum": ["error", "convert"],
          "description": "Whether global deterministic fidelity-changing rules are denied or explicitly authorized. Scoped per-icon layered fallbacks remain separately authorized."
        },
        "unrepresentable": {
          "enum": ["error", "skip"],
          "description": "Whether sources without a faithful conversion in the bounded deterministic profile fail or are explicitly omitted."
        }
      }
    },
    "textFont": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "sha256"],
      "properties": {
        "family": { "type": "string", "minLength": 1, "maxLength": 127 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "format",
        "file",
        "sha256",
        "bytes",
        "unitsPerEm",
        "ascent",
        "descent",
        "tables"
      ],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "format": { "const": "OpenType/CFF" },
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "unitsPerEm": { "type": "integer", "minimum": 16, "maximum": 16384 },
        "ascent": { "type": "integer" },
        "descent": { "type": "integer" },
        "tables": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "layerFont": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paintOrder",
        "family",
        "format",
        "file",
        "sha256",
        "bytes",
        "glyphCount",
        "unitsPerEm",
        "ascent",
        "descent",
        "tables"
      ],
      "properties": {
        "paintOrder": { "type": "integer", "minimum": 0, "maximum": 7 },
        "family": { "type": "string", "minLength": 1, "maxLength": 63 },
        "format": { "const": "OpenType/CFF" },
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "glyphCount": { "type": "integer", "minimum": 1, "maximum": 65534 },
        "unitsPerEm": { "type": "integer", "minimum": 16, "maximum": 16384 },
        "ascent": { "type": "integer" },
        "descent": { "type": "integer" },
        "tables": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "dart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "file", "fontPackage"],
      "properties": {
        "className": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9_]*$",
          "maxLength": 40
        },
        "file": { "type": "string", "minLength": 1 },
        "fontPackage": { "type": ["string", "null"] }
      }
    },
    "glyphV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "name",
        "codepoint",
        "sourceSha256",
        "geometrySha256",
        "sourceBytes",
        "sourceShapes",
        "pathCommands",
        "viewBox",
        "fontBounds",
        "advance",
        "matchTextDirection",
        "conversion",
        "issues"
      ],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$", "maxLength": 40 },
        "codepoint": { "type": "string", "pattern": "^0x[0-9A-F]+$" },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "geometrySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceBytes": { "type": "integer", "minimum": 1 },
        "sourceShapes": { "type": "integer", "minimum": 1 },
        "pathCommands": { "type": "integer", "minimum": 1 },
        "viewBox": { "$ref": "#/$defs/quad" },
        "fontBounds": { "$ref": "#/$defs/quad" },
        "advance": { "type": "integer", "minimum": 1 },
        "matchTextDirection": { "type": "boolean" },
        "conversion": { "enum": ["lossless", "approximated"] },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/lossyIssue" }
        },
        "layeredRendering": { "$ref": "#/$defs/layeredRendering" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "conversion": { "const": "lossless" } },
            "required": ["conversion"]
          },
          "then": { "properties": { "issues": { "maxItems": 0 } } }
        },
        {
          "if": {
            "properties": { "conversion": { "const": "approximated" } },
            "required": ["conversion"]
          },
          "then": { "properties": { "issues": { "minItems": 1 } } }
        }
      ]
    },
    "layeredRendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lossless", "fallback", "layers"],
      "properties": {
        "lossless": { "const": true },
        "fallback": { "enum": ["silhouette", "opaque-only"] },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/renderLayer" }
        }
      }
    },
    "renderLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paintOrder",
        "opacity",
        "fontFamily",
        "fontFile",
        "codepoint",
        "fontBounds"
      ],
      "properties": {
        "paintOrder": { "type": "integer", "minimum": 0, "maximum": 7 },
        "opacity": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "fontFamily": { "type": "string", "minLength": 1, "maxLength": 63 },
        "fontFile": { "type": "string", "minLength": 1 },
        "codepoint": { "type": "string", "pattern": "^0x[0-9A-F]+$" },
        "fontBounds": { "$ref": "#/$defs/quad" }
      }
    },
    "glyphV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "name",
        "codepoint",
        "sourceSha256",
        "geometrySha256",
        "sourceBytes",
        "sourceShapes",
        "pathCommands",
        "viewBox",
        "fontBounds",
        "advance",
        "matchTextDirection"
      ],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$", "maxLength": 40 },
        "codepoint": { "type": "string", "pattern": "^0x[0-9A-F]+$" },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "geometrySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceBytes": { "type": "integer", "minimum": 1 },
        "sourceShapes": { "type": "integer", "minimum": 1 },
        "pathCommands": { "type": "integer", "minimum": 1 },
        "viewBox": { "$ref": "#/$defs/quad" },
        "fontBounds": { "$ref": "#/$defs/quad" },
        "advance": { "type": "integer", "minimum": 1 },
        "matchTextDirection": { "type": "boolean" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "skippedIcon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "name",
        "codepoint",
        "sourceSha256",
        "sourceBytes",
        "previouslyEmitted",
        "issues"
      ],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$", "maxLength": 40 },
        "codepoint": { "type": "string", "pattern": "^0x[0-9A-F]+$" },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceBytes": { "type": "integer", "minimum": 1 },
        "previouslyEmitted": { "type": "boolean" },
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/skippedIssue" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "source",
        "classification",
        "action",
        "feature"
      ],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["lossy", "unrepresentable"] },
        "action": { "enum": ["converted", "skipped"] },
        "feature": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      }
    },
    "lossyIssue": {
      "allOf": [
        { "$ref": "#/$defs/issue" },
        {
          "properties": {
            "classification": { "const": "lossy" },
            "action": { "const": "converted" }
          }
        }
      ]
    },
    "scopedLayeredFallbackIssue": {
      "allOf": [
        { "$ref": "#/$defs/lossyIssue" },
        {
          "required": ["details"],
          "properties": {
            "code": {
              "enum": [
                "SVG_PARTIAL_ALPHA_APPROXIMATED",
                "SVG_PARTIAL_ALPHA_DROPPED"
              ]
            },
            "feature": { "const": "fractional-alpha" },
            "details": {
              "type": "object",
              "required": [
                "approximation",
                "losslessLayeredOutput",
                "occurrences",
                "scope"
              ],
              "properties": {
                "approximation": {
                  "enum": ["any-positive-alpha-to-opaque", "opaque-only"]
                },
                "losslessLayeredOutput": { "const": true },
                "occurrences": { "type": "integer", "minimum": 1 },
                "scope": { "const": "single-glyph-fallback" }
              }
            }
          },
          "oneOf": [
            {
              "properties": {
                "code": { "const": "SVG_PARTIAL_ALPHA_APPROXIMATED" },
                "details": {
                  "properties": {
                    "approximation": {
                      "const": "any-positive-alpha-to-opaque"
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "code": { "const": "SVG_PARTIAL_ALPHA_DROPPED" },
                "details": {
                  "properties": {
                    "approximation": { "const": "opaque-only" }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "skippedIssue": {
      "allOf": [
        { "$ref": "#/$defs/issue" },
        {
          "properties": {
            "classification": { "const": "unrepresentable" },
            "action": { "const": "skipped" }
          }
        }
      ]
    },
    "quad": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "minItems": 4,
      "maxItems": 4
    }
  }
}
