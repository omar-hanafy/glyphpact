---
/**
 * The page shell: metadata, fonts, landmarks, navigation, footer.
 *
 * Every absolute URL here is built by `absolute()` so canonical links, Open
 * Graph, social cards, and the sitemap all agree, and so moving to a custom
 * domain stays a one-value change.
 */
import '../styles/global.css';
import { site, absolute, path, RELEASE } from '../site.config';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** Page title, without the site-name suffix. */
  title: string;
  description: string;
  /** Route path for the canonical URL, e.g. `/flutter/`. */
  canonical: string;
  /** Social card slug; resolves to /og/<slug>.png. */
  ogSlug: string;
  /** Structured data objects, serialised into one script per object. */
  jsonLd?: Record<string, unknown>[];
  /** Keeps a page out of search results. Used for 404 only. */
  noindex?: boolean;
}

const { title, description, canonical, ogSlug, jsonLd = [], noindex = false } = Astro.props;

const canonicalUrl = absolute(canonical);
const ogImage = absolute(`/og/${ogSlug}.png`);
const fullTitle = title.includes(site.name) ? title : `${title} - ${site.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} - ${site.name}`} />
    <meta property="og:locale" content="en" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${title} - ${site.name}`} />

    <link rel="icon" href={path('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href={path('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#0b0d10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbfc" media="(prefers-color-scheme: light)" />

    <meta name="author" content={site.author.name} />
    <meta name="generator" content={Astro.generator} />

    {/* Both faces are used above the fold: sans for the headline, mono for the
        install command. Nothing else is preloaded. */}
    <link
      rel="preload"
      href={path('/fonts/geist-latin.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={path('/fonts/geist-mono-latin.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      jsonLd.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
      ))
    }

    {/* Copy controls are hidden by CSS until this flag is set. Running here,
        before the body is parsed, means the buttons are either painted from the
        very first frame or never painted - so enhancement costs no layout
        shift, and a browser without the Clipboard API simply never shows
        them. */}
    <script is:inline>
      if (navigator.clipboard && navigator.clipboard.writeText) {
        document.documentElement.dataset.clipboard = 'ready';
      }
    </script>
  </head>

  <body>
    <a class="gp-skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer version={RELEASE.version} />

    {/* Shipped behaviour is progressively enhanced. The semantic table and
        every copyable value remain available when JavaScript is disabled. */}
    <script>
      import { mountStickyTables } from '../lib/stickyTables';

      const copyResetTimers = new WeakMap<HTMLButtonElement, number>();

      document.addEventListener('click', async (event) => {
        const target = event.target as Element | null;
        const button = target?.closest<HTMLButtonElement>('[data-gp-copy]');
        if (!button) return;

        const value = button.dataset.gpCopy ?? '';
        const label = button.querySelector('[data-gp-copy-label]');
        const feedback = button.previousElementSibling?.matches('[data-gp-copy-feedback]')
          ? button.previousElementSibling
          : null;
        const originalVisibleLabel = label?.textContent ?? 'Copy';
        const originalAccessibleLabel =
          button.dataset.gpCopyAccessibleLabel ?? button.getAttribute('aria-label') ?? 'Copy';
        const copiedTarget =
          originalAccessibleLabel.replace(/^Copy(?:\s+the)?\s*/i, '').trim() || 'content';

        const pendingReset = copyResetTimers.get(button);
        if (pendingReset) window.clearTimeout(pendingReset);
        if (feedback) feedback.textContent = '';

        try {
          await navigator.clipboard.writeText(value);
          button.dataset.state = 'done';
          if (label) label.textContent = 'Copied';
          button.setAttribute('aria-label', `Copied ${copiedTarget}`);
          if (feedback) feedback.textContent = `Copied ${copiedTarget} to clipboard.`;
        } catch {
          // Permission denied or a non-secure context. Say so rather than
          // reporting a success that did not happen.
          button.dataset.state = 'error';
          if (label) label.textContent = 'Copy failed';
          button.setAttribute('aria-label', `Copy failed for ${copiedTarget}`);
          if (feedback) {
            feedback.textContent = `Could not copy ${copiedTarget}. Select it and copy it manually.`;
          }
        }

        const resetTimer = window.setTimeout(() => {
          delete button.dataset.state;
          button.setAttribute('aria-label', originalAccessibleLabel);
          if (label) label.textContent = originalVisibleLabel;
          if (feedback) feedback.textContent = '';
          copyResetTimers.delete(button);
        }, 2000);
        copyResetTimers.set(button, resetTimer);
      });

      mountStickyTables();
    </script>
  </body>
</html>
