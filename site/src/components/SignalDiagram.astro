---
type Tone = 'locked' | 'manual' | 'neutral';

interface Lane {
  label: string;
  tone: Tone;
  nodes: string[];
  meta: string;
}

interface Props {
  title: string;
  caption: string;
  lanes: Lane[];
}

const { title, caption, lanes } = Astro.props;
---

<figure class:list={['gp-signal', lanes.length > 1 && 'gp-signal--split']}>
  <figcaption class="gp-signal__caption">
    <span>{caption}</span>
    <strong>{title}</strong>
  </figcaption>

  <div class="gp-signal__lanes">
    {
      lanes.map((lane) => (
        <div class:list={['gp-signal__lane', `gp-signal__lane--${lane.tone}`]}>
          <div class="gp-signal__label">
            <span aria-hidden="true"></span>
            <strong>{lane.label}</strong>
          </div>
          <ol style={`--signal-nodes: ${lane.nodes.length}`}>
            {lane.nodes.map((node) => (
              <li>
                <code>{node}</code>
              </li>
            ))}
          </ol>
          <p>{lane.meta}</p>
        </div>
      ))
    }
  </div>
</figure>

<style>
  .gp-signal {
    --signal-color: var(--accent);
    position: relative;
    margin: 0;
    padding: clamp(1rem, 2.8vw, 1.6rem);
    border: 1px solid var(--rule-strong);
    border-radius: var(--gp-radius-lg);
    background:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px),
      var(--bg-sunken);
    background-size: 22px 22px;
    box-shadow: var(--shadow);
    overflow: hidden;
    min-width: 0;
  }

  .gp-signal::before,
  .gp-signal::after {
    content: '';
    position: absolute;
    inline-size: 1.2rem;
    block-size: 1.2rem;
    pointer-events: none;
  }

  .gp-signal::before {
    inset: 0.55rem auto auto 0.55rem;
    border-block-start: 1px solid var(--accent);
    border-inline-start: 1px solid var(--accent);
  }

  .gp-signal::after {
    inset: auto 0.55rem 0.55rem auto;
    border-inline-end: 1px solid var(--accent);
    border-block-end: 1px solid var(--accent);
  }

  .gp-signal__caption {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block-end: 0.9rem;
    border-block-end: 1px solid var(--rule);
    font-family: var(--gp-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .gp-signal__caption strong {
    color: var(--text-muted);
    font-weight: 500;
    text-align: end;
  }

  .gp-signal__lanes {
    display: grid;
    gap: 1rem;
    padding-block-start: 1rem;
  }

  .gp-signal--split .gp-signal__lanes {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .gp-signal.gp-signal--split ol {
    grid-template-columns: minmax(0, 1fr);
    gap: 1.35rem;
  }

  .gp-signal.gp-signal--split li:not(:last-child)::after {
    content: '↓';
    inset-inline-start: 50%;
    inset-block-start: calc(100% + 0.08rem);
    translate: -50% 0;
  }

  .gp-signal__lane {
    min-width: 0;
    padding: 0.9rem;
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg-raised) 82%, transparent);
  }

  .gp-signal__lane--manual {
    --signal-color: var(--lossy);
  }

  .gp-signal__lane--neutral {
    --signal-color: var(--text-faint);
  }

  .gp-signal__label {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-block-end: 0.8rem;
    color: var(--signal-color);
    font-family: var(--gp-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .gp-signal__label > span {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border: 1px solid currentcolor;
    transform: rotate(45deg);
  }

  .gp-signal__label strong {
    font-weight: 600;
  }

  .gp-signal ol {
    display: grid;
    grid-template-columns: repeat(var(--signal-nodes), minmax(0, 1fr));
    align-items: center;
    gap: 1.15rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .gp-signal li {
    position: relative;
    min-width: 0;
    padding: 0.7rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--signal-color) 48%, var(--rule));
    background: var(--bg);
    text-align: center;
  }

  .gp-signal li:not(:last-child)::after {
    content: '→';
    position: absolute;
    inset-inline-start: calc(100% + 0.28rem);
    inset-block-start: 50%;
    translate: 0 -50%;
    color: var(--signal-color);
    font-family: var(--gp-font-mono);
    font-size: 0.8rem;
  }

  .gp-signal code {
    display: block;
    color: var(--text);
    background: transparent;
    border: 0;
    padding: 0;
    font-size: 0.68rem;
    overflow-wrap: anywhere;
  }

  .gp-signal__lane > p {
    margin-block-start: 0.75rem;
    color: var(--text-faint);
    font-family: var(--gp-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 67rem) {
    .gp-signal--split .gp-signal__lanes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 38rem) {
    .gp-signal__caption {
      flex-direction: column;
    }

    .gp-signal__caption strong {
      text-align: start;
    }

    .gp-signal ol {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.35rem;
    }

    .gp-signal li:not(:last-child)::after {
      content: '↓';
      inset-inline-start: 50%;
      inset-block-start: calc(100% + 0.08rem);
      translate: -50% 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .gp-signal li {
      animation: gp-signal-in 420ms both;
    }

    .gp-signal li:nth-child(2) {
      animation-delay: 80ms;
    }

    .gp-signal li:nth-child(3) {
      animation-delay: 160ms;
    }

    .gp-signal li:nth-child(4) {
      animation-delay: 240ms;
    }
  }

  @keyframes gp-signal-in {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
