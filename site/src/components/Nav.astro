---
import { site, path, routes, navRoutes } from '../site.config';
import BrandMark from './BrandMark.astro';
import GitHubIcon from './GitHubIcon.astro';

/** Trailing slashes are normalised so `aria-current` survives either form. */
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => {
  const target = path(href).replace(/\/+$/, '') || '/';
  return here === target;
};
---

<header class="gp-header">
  <div class="gp-shell gp-header__inner">
    <a class="gp-brand" href={path('/')} aria-current={isCurrent('/') ? 'page' : undefined}>
      <BrandMark size="1.4rem" />
      {site.name}
    </a>

    <nav class="gp-nav" aria-label="Main">
      {
        navRoutes.map((key) => (
          <a
            href={path(routes[key].href)}
            aria-current={isCurrent(routes[key].href) ? 'page' : undefined}
          >
            {routes[key].nav}
          </a>
        ))
      }
      <a class="gp-nav__repo" href={site.links.repo}>
        <GitHubIcon />
        GitHub
      </a>
    </nav>
  </div>
</header>
