---
import { site, path, routes, navRoutes } from '../site.config';
import BrandMark from './BrandMark.astro';
import CoffeeIcon from './CoffeeIcon.astro';
import GitHubIcon from './GitHubIcon.astro';

/** Trailing slashes are normalised so `aria-current` survives either form. */
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => {
  const target = path(href).replace(/\/+$/, '') || '/';
  return here === target;
};
---

<header class="gp-header">
  <div class="gp-shell gp-header__inner">
    <a class="gp-brand" href={path('/')} aria-current={isCurrent('/') ? 'page' : undefined}>
      <BrandMark size="1.4rem" />
      {site.name}
    </a>

    <nav class="gp-nav gp-nav--desktop" aria-label="Main">
      {
        navRoutes.map((key) => (
          <a
            href={path(routes[key].href)}
            aria-current={isCurrent(routes[key].href) ? 'page' : undefined}
          >
            {routes[key].nav}
          </a>
        ))
      }
      <a class="gp-nav__utility gp-nav__coffee" href={site.links.support}>
        <CoffeeIcon />
        Buy me a coffee
      </a>
      <a class="gp-nav__utility" href={site.links.repo}>
        <GitHubIcon />
        GitHub
      </a>
    </nav>

    <details class="gp-mobile-nav">
      <summary>
        <span>Menu</span>
        <span class="gp-mobile-nav__icon" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </summary>
      <nav class="gp-mobile-nav__panel" aria-label="Main">
        {
          navRoutes.map((key) => (
            <a
              href={path(routes[key].href)}
              aria-current={isCurrent(routes[key].href) ? 'page' : undefined}
            >
              {routes[key].nav}
            </a>
          ))
        }
        <a class="gp-nav__utility gp-nav__coffee" href={site.links.support}>
          <CoffeeIcon />
          Buy me a coffee
        </a>
        <a class="gp-nav__utility" href={site.links.repo}>
          <GitHubIcon />
          GitHub
        </a>
      </nav>
    </details>
  </div>
</header>
